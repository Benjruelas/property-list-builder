# Capacitor native builds — API origin (required for iOS/Android; not used by web/PWA)
# Example: https://property-list-builder.vercel.app/api
VITE_API_URL=

# Web Push — generate keys: npx web-push generate-vapid-keys
# Use the same public key for both (Vite exposes VITE_* to the client).
VITE_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: URL required by Web Push (e.g. mailto:you@yourdomain.com)
VAPID_SUBJECT=mailto:notify@example.com

# Google Map Tiles API — PRIMARY basemap (satellite / street / hybrid)
# Required for production basemap quality. Enable "Map Tiles API" in GCP:
# https://console.cloud.google.com/apis/library/tile.googleapis.com
# Add to Vercel → Environment Variables (Production + Preview).
# Verify: GET /api/google-tiles-session?mapType=satellite → { tileUrl, expiry }
GOOGLE_MAPS_TILES_KEY=

# Mapbox — geocoding (address search) + basemap FALLBACK when Google session unavailable
# Sign up at https://mapbox.com → create a default public token
VITE_MAPBOX_ACCESS_TOKEN=

# LandRecords.us — nationwide parcel vector tiles
LANDRECORDS_API_KEY=
LANDRECORDS_TILE_URL=https://api.landrecords.us/pro/gwc/service/tms/1.0.0/pro:parcel_us@EPSG:3857x2@pbf

# Cloudflare R2 — tile cache (zero-egress re-serving)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=parcel-tiles

# Roof Inspector — Google Solar API (hi-res roof imagery)
GOOGLE_SOLAR_API_KEY=

# Roof Inspector — Copernicus Sentinel Hub (historical satellite imagery)
# Register at https://dataspace.copernicus.eu → Dashboard → OAuth clients
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Roof Inspector — Anthropic Claude (AI vision analysis)
ANTHROPIC_API_KEY=

# Roof Inspector — EagleView Imagery API (oblique + orthogonal aerial images)
# Get your key at https://developer.eagleview.com
EAGLEVIEW_API_KEY=

# Roof Inspector — EagleView Imagery API (oblique + orthogonal aerial images)
# Get your key at https://developer.eagleview.com
EAGLEVIEW_API_KEY=

# Skip tracing — Trestle IQ Reverse Address API (parcel address → residents + phones/emails)
# Get your key at https://trestleiq.com → API dashboard
TRESTLE_API_KEY=

# --- Infra feature flags (server-side, Vercel env) ---
# All default off. Enable incrementally; flip back to 0/false to roll back.
#
# FLAG_LEADS_LOCK=1 — serializes concurrent lead/pipeline KV writes (recommended for prod).
#   Prevents batch photo uploads from clobbering each other. Also enables PIPELINES_LOCK.
# FLAG_LEADS_SHARDED=off|shadow|on — per-owner lead shards (keep off until validated)
# FLAG_PIPELINES_SHARDED=off|shadow|on — per-owner pipeline shards
# FLAG_VERSIONED_POLL=1 — ETag-based 304 polling for leads/pipelines
# FLAG_PRESIGNED_PHOTOS=1 — direct R2 upload/download via presigned URLs
# FLAG_LEADS_LIST_VIEW=1 — lightweight list projection for lead polls
# VITE_PRESIGNED_PHOTOS=1 — client-side presigned upload path (requires FLAG_PRESIGNED_PHOTOS)
# INFRA_TIMING=0 — disable timing logs from api/lib/timing.js
