# ============================================================
# KnockScout environment template
# Client vars must be prefixed VITE_ (exposed to the browser).
# Everything else is server-side only (Vercel env vars).
# ============================================================

# --- Firebase (required) ------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Server-side Firebase token verification (identitytoolkit lookup)
FIREBASE_API_KEY=

# --- Storage: Vercel KV / Redis (required) ------------------
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Alternative to Vercel KV: a standard Redis connection string
REDIS_URL=

# --- Cloudflare R2 (required for tiles/photos/files/PDFs) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=parcel-tiles

# --- Security secrets (REQUIRED in production) ---------------
# HMAC secret for public preview links (quotes/reports). Min 16 chars,
# use >= 32 random bytes: `openssl rand -hex 32`. Production fails closed
# without it.
PREVIEW_LINK_SECRET=
# Vercel Cron authentication. Set the same value in the Vercel dashboard;
# production cron requests without it are rejected.
CRON_SECRET=
# Migration endpoint (/api/migrate-infra): shared secret + admin allowlist.
MIGRATE_SECRET=
# Comma-separated Firebase UIDs or emails allowed to run migrations.
MIGRATE_ADMIN_UIDS=
# NEVER set in production — grants synthetic users for `Bearer dev-bypass`.
# Hard-disabled when VERCEL_ENV/NODE_ENV is production.
ENABLE_DEV_BYPASS=
# Optional CORS origin allowlist for API routes (comma-separated).
# Leave empty to allow any origin (Capacitor apps send no Origin header).
ALLOWED_ORIGINS=

# --- Basemap & parcel tiles ----------------------------------
# Google Map Tiles API — PRIMARY basemap (satellite / street / hybrid)
# Enable: https://console.cloud.google.com/apis/library/tile.googleapis.com
# Restrict the key to your production domains + app bundle IDs in GCP.
GOOGLE_MAPS_TILES_KEY=
# Mapbox — geocoding (address search) + basemap fallback.
# Restrict the token by URL in the Mapbox dashboard.
VITE_MAPBOX_ACCESS_TOKEN=
# Optional server Mapbox token for Lead/Deal share OG cards (/api/share-card).
# Falls back to VITE_MAPBOX_ACCESS_TOKEN when unset.
MAPBOX_ACCESS_TOKEN=
# LandRecords.us — nationwide parcel vector tiles (runtime fallback while owned coverage grows)
LANDRECORDS_API_KEY=
LANDRECORDS_TILE_URL=https://api.landrecords.us/pro/gwc/service/tms/1.0.0/pro:parcel_us@EPSG:3857x2@pbf
# When 1/true, /api/tiles serves only R2 owned/tiles (no LandRecords). Keep off until coverage is reviewed.
PARCEL_TILES_OWNED_ONLY=
# Ops secret for /api/parcel-pipeline/* (falls back to CRON_SECRET)
PARCEL_PIPELINE_SECRET=
# CLI → deployed API (claim/report/status). Example: https://knockscout.app
PARCEL_PIPELINE_API_BASE=
# Optional agent id written on claim/report
PARCEL_PIPELINE_AGENT=

# --- Email (Resend) ------------------------------------------
RESEND_API_KEY=
# From address for form/quote/report emails (verified domain in Resend)
FORMS_FROM_EMAIL=
# From address for auth emails (password reset). Example: KnockScout <noreply@knockscout.com>
AUTH_FROM_EMAIL=

# --- Firebase Admin (password reset links) -------------------
# Option A: full service account JSON (single line)
FIREBASE_SERVICE_ACCOUNT_JSON=
# Option B: individual fields (typical on Vercel)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Canonical app URL for auth email links (production: https://knockscout.app)
APP_ORIGIN=

# --- Stripe (quote payments) ---------------------------------
STRIPE_SECRET_KEY=
# Webhook signing secret — register checkout.session.completed to
# https://your-domain/api/stripe-webhook
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=

# --- Skip tracing --------------------------------------------
# Trestle IQ Reverse Address API (primary)
TRESTLE_API_KEY=
# BatchData (async job-based)
BATCHDATA_API_KEY=
# SkipSherpa (opt-in)
USE_SKIPSHERPA=
SKIPSHERPA_API_KEY=
# Tracerfy (opt-in)
USE_TRACERFY=
TRACERFY_API_KEY=
# Max parcels per skip-trace request (default 25)
MAX_SKIP_TRACE_BATCH=

# --- Google Business Profile (reviews on quotes/reports) -----
# OAuth client for Business Profile APIs (business.manage scope).
# Enable Account Management, Business Information, and My Business APIs.
# Redirect URI must match GOOGLE_GBP_REDIRECT_URI (or APP_ORIGIN + /api/google-business-callback).
GOOGLE_GBP_CLIENT_ID=
GOOGLE_GBP_CLIENT_SECRET=
GOOGLE_GBP_REDIRECT_URI=
# AES key material for encrypting refresh tokens at rest (>=16 chars).
GOOGLE_GBP_TOKEN_SECRET=

# --- Roof Inspector ------------------------------------------
# Google Solar API (hi-res roof imagery + DSM)
GOOGLE_SOLAR_API_KEY=
# Copernicus Sentinel Hub (historical satellite imagery)
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
# Anthropic Claude (AI vision analysis)
ANTHROPIC_API_KEY=
# EagleView Imagery API (oblique + orthogonal aerial images)
EAGLEVIEW_API_KEY=

# --- Web Push -------------------------------------------------
# Generate keys: npx web-push generate-vapid-keys
# Use the same public key for both (Vite exposes VITE_* to the client).
VITE_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: URL required by Web Push (e.g. mailto:you@yourdomain.com)
VAPID_SUBJECT=mailto:notify@example.com

# --- Error tracking (optional) --------------------------------
# Sentry browser DSN — error tracking loads only when set.
VITE_SENTRY_DSN=
# Sentry performance tracing sample rate (0 disables tracing)
VITE_SENTRY_TRACES_RATE=

# --- Capacitor native builds ----------------------------------
# API origin for iOS/Android builds (not used by web/PWA).
# Example: https://your-domain.com/api
VITE_API_URL=

# --- Infra feature flags (server-side, Vercel env) -------------
# FLAG_LEADS_LOCK / FLAG_PIPELINES_LOCK — distributed write locks.
#   Default ON in production; set 0 to disable (not recommended).
# FLAG_LISTS_LOCK / FLAG_PATHS_LOCK / FLAG_FORM_TEMPLATES_LOCK / FLAG_TASKS_LOCK
#   Default ON in production; distributed locks on remaining monolith keys.
# FLAG_LEADS_SHARDED=off|shadow|on — per-owner lead shards (read cutover)
# FLAG_PIPELINES_SHARDED=off|shadow|on — per-owner pipeline shards
# FLAG_VERSIONED_POLL=1 — ETag-based 304 polling for leads/pipelines
# FLAG_LEADS_LIST_VIEW=1 — lightweight list projection for lead polls
# FLAG_AUTH_CACHE=1 — local JWT verify + LRU cache (requires FIREBASE_PROJECT_ID)
# FLAG_AUTH_CACHE_SHADOW=1 — log local vs REST auth mismatches without switching
# FLAG_PRESIGNED_PHOTOS=1 — direct R2 upload/download via presigned URLs
# VITE_PRESIGNED_PHOTOS=1 — client-side presigned upload path (requires FLAG_PRESIGNED_PHOTOS)
# VITE_PHOTO_DIRECT_R2_UPLOAD=1 — browser PUT to R2 for photos/annotations (fast path; requires R2 bucket CORS)
# INFRA_TIMING=0 — disable timing logs from api/lib/timing.js
