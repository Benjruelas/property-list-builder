{
  "functions": {
    "api/tiles.js": {
      "maxDuration": 30
    },
    "api/parcel.js": {
      "maxDuration": 30
    },
    "api/cron-task-reminders.js": {
      "maxDuration": 60
    },
    "api/solar-imagery.js": {
      "maxDuration": 30
    },
    "api/sentinel-imagery.js": {
      "maxDuration": 60
    },
    "api/hail-events.js": {
      "maxDuration": 120,
      "memory": 1024
    },
    "api/roof-report.js": {
      "maxDuration": 120,
      "memory": 1024
    },
    "api/photo-reports-generate.js": {
      "maxDuration": 120,
      "memory": 1024
    },
    "api/eagleview-imagery.js": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.knockscout.app" }],
      "destination": "https://knockscout.app/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/__/firebase/init.json",
      "destination": "/api/firebase-init"
    },
    {
      "source": "/__/auth/:path*",
      "destination": "/api/firebase-auth-proxy?path=:path"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/((?!api/|@vite|@react-refresh|@fs/|src/|node_modules/|assets/|manifest\\.webmanifest|favicon|icon-|sw\\.js).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-task-reminders",
      "schedule": "*/5 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, OPTIONS, POST, PATCH, DELETE"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization, X-Requested-With"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/((?!api/).*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), geolocation=(self), microphone=(), payment=()"
        }
      ]
    }
  ]
}
